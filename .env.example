# Copy to .env and fill in. .env is gitignored and must never be committed.

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# The domain pointed at this machine. Caddy gets a certificate for it.
VAULTIQ_DOMAIN=vault.example.com

# Only with docker-compose.release.yml: which published server image to run.
# Leave unset for `latest`; pin a version for anything you depend on.
# VAULTIQ_VERSION=

<?xml version="1.0" encoding="utf-8"?>
<!-- The Vaultiq dial (LogoMark.tsx "detailed" variant), hand-ported to a
     vector drawable for the native splash. See CLAUDE.md §0. Approximate,
     not pixel-exact: this is shown for a fraction of a second at cold
     start, so hand-porting it once here is worth it, but chasing perfect
     fidelity in XML path data isn't. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="104dp"
    android:height="104dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

  <!-- Thin outer guide ring -->
  <path
      android:pathData="M3,60 a57,57 0 1,0 114,0 a57,57 0 1,0 -114,0"
      android:strokeColor="#FFF8E8"
      android:strokeAlpha="0.6"
      android:strokeWidth="1.6"
      android:fillColor="#00000000" />

  <!-- Outer ring -->
  <path
      android:pathData="M11,60 a49,49 0 1,0 98,0 a49,49 0 1,0 -98,0"
      android:strokeColor="#FFF8E8"
      android:strokeWidth="6"
      android:fillColor="#00000000" />

  <!-- Inner ring -->
  <path
      android:pathData="M27,60 a33,33 0 1,0 66,0 a33,33 0 1,0 -66,0"
      android:strokeColor="#FFF8E8"
      android:strokeWidth="3"
      android:fillColor="#00000000" />

  <!-- Three spokes, 120 degrees apart -->
  <group android:pivotX="60" android:pivotY="60" android:rotation="60">
    <path android:pathData="M56.5,18 L63.5,18 L63.5,42 L56.5,42 Z" android:fillColor="#FFF8E8" />
  </group>
  <group android:pivotX="60" android:pivotY="60" android:rotation="180">
    <path android:pathData="M56.5,18 L63.5,18 L63.5,42 L56.5,42 Z" android:fillColor="#FFF8E8" />
  </group>
  <group android:pivotX="60" android:pivotY="60" android:rotation="300">
    <path android:pathData="M56.5,18 L63.5,18 L63.5,42 L56.5,42 Z" android:fillColor="#FFF8E8" />
  </group>

  <!-- Center hub -->
  <path
      android:pathData="M47,60 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
      android:fillColor="#FFF8E8" />

  <!-- Tick -->
  <path android:pathData="M57.5,10 L62.5,10 L62.5,24 L57.5,24 Z" android:fillColor="#AAB396" />
</vector>

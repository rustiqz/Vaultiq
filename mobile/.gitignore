# pw-crypto-core's Android build output: the cross-compiled .so and the
# Kotlin bindings uniffi generates from it. Neither is committed, same as
# extension/vendor/ for the wasm bindings -- run `pnpm run crypto` to
# regenerate both (CLAUDE.md §3.9 forbids committing build output).
android/app/src/main/jniLibs/
android/app/src/main/java/uniffi/

# OSX
#
.DS_Store

# Xcode
#
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

